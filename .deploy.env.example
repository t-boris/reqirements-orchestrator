# =============================================================================
# MARO 2.0 Deployment Configuration - Copy to .deploy.env and fill in values
# =============================================================================
# These variables are used by deployment scripts to configure GCP resources.

# -----------------------------------------------------------------------------
# GCP Project Configuration (Required)
# -----------------------------------------------------------------------------
# Your Google Cloud Project ID
# Find at: https://console.cloud.google.com/ (dropdown in header)
GCP_PROJECT=your-project-id

# -----------------------------------------------------------------------------
# GCE Virtual Machine Configuration
# -----------------------------------------------------------------------------
# Name of the GCE instance to deploy to
GCE_INSTANCE=maro-vm

# GCE zone where the instance is located
# See available zones: https://cloud.google.com/compute/docs/regions-zones
GCE_ZONE=us-central1-a

# -----------------------------------------------------------------------------
# Artifact Registry Configuration
# -----------------------------------------------------------------------------
# Region for Artifact Registry (where Docker images are stored)
REGION=us-central1

# Artifact Registry repository name
REPO=maro

# -----------------------------------------------------------------------------
# Usage
# -----------------------------------------------------------------------------
# After copying to .deploy.env, run deployment with:
#   ./scripts/deploy.sh
#
# The deployment script will:
# 1. Build and push Docker image to Artifact Registry
# 2. SSH into GCE instance
# 3. Pull the new image and restart containers
