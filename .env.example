# =============================================================================
# MARO 2.0 Configuration - Copy to .env and fill in values
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Configuration (Required: at least one provider)
# -----------------------------------------------------------------------------
# The application uses LiteLLM for provider-agnostic LLM calls.
# Configure the provider prefix, model name, and API key.

# LLM Provider prefix for LiteLLM (gemini, openai, anthropic)
LLM_PROVIDER=gemini

# Model name (will be combined with provider as provider/model)
# Examples: gemini-2.5-pro, gpt-4o-mini, claude-3-haiku-20240307
LLM_MODEL=gemini-2.5-pro

# API key for the chosen provider
# For Gemini: Get from https://aistudio.google.com/app/apikey
# For OpenAI: Get from https://platform.openai.com/api-keys
# For Anthropic: Get from https://console.anthropic.com/settings/keys
LLM_API_KEY=your-api-key-here

# Temperature for LLM calls (0.0-1.0, lower = more deterministic)
LLM_TEMPERATURE=0.1

# Max retries for structured output validation failures
LLM_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# Slack Configuration (Required)
# -----------------------------------------------------------------------------
# Bot token - starts with xoxb-
# Get from: Slack App > OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-level token for Socket Mode - starts with xapp-
# Get from: Slack App > Basic Information > App-Level Tokens
SLACK_APP_TOKEN=xapp-your-app-token

# Signing secret for request verification
# Get from: Slack App > Basic Information > Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret

# -----------------------------------------------------------------------------
# Jira Configuration (Optional - required for ticket creation)
# -----------------------------------------------------------------------------
# Jira instance URL
JIRA_URL=https://your-domain.atlassian.net

# User email for API authentication
JIRA_USER=your-email@example.com

# API token from Atlassian account settings
# Get from: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-jira-api-token

# Default project key (optional - can be overridden per request)
JIRA_DEFAULT_PROJECT=PROJ

# Dry run mode - log operations instead of calling Jira API (true|false)
JIRA_DRY_RUN=false

# -----------------------------------------------------------------------------
# Database Configuration (Required)
# -----------------------------------------------------------------------------
# PostgreSQL connection settings (used to build connection URL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=maro
POSTGRES_PASSWORD=maro
POSTGRES_DBNAME=maro

# For docker-compose - set a secure password in production
# POSTGRES_PASSWORD=your-secure-password

# -----------------------------------------------------------------------------
# Event Store Settings
# -----------------------------------------------------------------------------
# Enable aggregate snapshotting for performance (true|false)
IS_SNAPSHOTTING_ENABLED=true

# Create snapshot every N events per aggregate
SNAPSHOTTING_INTERVAL=500

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Environment (development|staging|production)
ENVIRONMENT=development

# Log level (DEBUG|INFO|WARNING|ERROR|CRITICAL)
LOG_LEVEL=INFO
